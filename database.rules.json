{
  "rules": {
    ".read": false,
    ".write": false,
    "groups": {
      "$syncCode": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['syncCode', 'group'])"
      }
    },
    "fcm_tokens": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "registered_users": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'name'])"
      }
    },
    "users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "user_groups": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "direct_expenses": {
      "$syncKey": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "direct_settlements": {
      "$syncKey": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "notification_triggers": {
      "$syncCode": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
